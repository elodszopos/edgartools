{
  "openapi": "3.1.0",
  "info": {
    "title": "edgar-sidecar",
    "summary": "HTTP wrapper around edgartools - the single SEC egress",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          },
          "edgartools_version": {
            "type": "string",
            "title": "Edgartools Version"
          },
          "identity_set": {
            "type": "boolean",
            "title": "Identity Set"
          }
        },
        "type": "object",
        "required": [
          "status",
          "edgartools_version",
          "identity_set"
        ],
        "title": "Health"
      }
    }
  }
}
